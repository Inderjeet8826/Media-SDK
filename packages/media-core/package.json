{
  "name": "@headless-media/core",
  "version": "1.0.0",
  "description": "Framework-agnostic core SDK for media fetching, caching, deduplication, and events",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --emitDeclarationOnly && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": ["media", "sdk", "pexels", "headless", "cache", "events"],
  "author": "",
  "license": "MIT"
}
