{
  "name": "@headless-media/ui-native",
  "version": "1.0.0",
  "description": "Headless UI component primitives for React Native (Grid, Lightbox, ReelSwiper)",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": "*"
  },
  "peerDependenciesMeta": {
    "react-native": {
      "optional": true
    }
  },
  "keywords": ["react-native", "headless", "ui", "grid", "lightbox", "reel-swiper"],
  "author": "",
  "license": "MIT"
}
