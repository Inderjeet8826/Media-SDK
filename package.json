{
  "name": "headless-media-sdk-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Production-grade Headless Media SDK Ecosystem Monorepo",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run --workspaces --if-present build",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "npm run --workspace=apps/web-app dev",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "npm run --workspaces --if-present typecheck"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^14.2.1",
    "@types/node": "^20.11.24",
    "@types/react": "^18.2.61",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "happy-dom": "^13.6.2",
    "typescript": "^5.3.3",
    "vite": "^5.1.4",
    "vitest": "^1.3.1"
  }
}
